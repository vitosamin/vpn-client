# Конфигурация сервиса активации (vpn-client/server).
# Скопировать в .env, заполнить секреты и выставить права: chmod 600 .env
# run.py сам подхватывает .env из своего каталога (окружение важнее файла).
# Запуск/остановка: ./run.sh start | stop | status | logs (см. README и
# docs/deploy-nas.md). Порт по умолчанию — 8089.

# --- HTTP-сервис ---
APP_HOST=127.0.0.1
APP_PORT=8089
DB_PATH=./data/activation.db
LOG_LEVEL=INFO
# 1 — доверять X-Forwarded-For от reverse proxy (Caddy/nginx), 0 — брать IP соединения
TRUST_PROXY=0
MAX_BODY_BYTES=8192

# --- СЕКРЕТЫ (обязательно поменять!) ---
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_TOKEN=
# Ключ HMAC для хэширования кодов. Если сменить — все выданные коды перестанут находиться.
CODE_PEPPER=

# --- одноразовые коды ---
# TTL кода в секундах (по умолчанию 24 ч, максимум 30 дней)
CODE_TTL_SECONDS=86400
# после стольких неудачных активаций с чужих device_id код блокируется
MAX_CODE_ATTEMPTS=10
# rate-limit по IP (запросов в минуту)
RATE_ACTIVATE_PER_MIN=10
RATE_ADMIN_PER_MIN=60
# «зависшая» активация старше N секунд может быть повторена тем же устройством
PROVISIONING_STALE_SECONDS=120

# --- тариф по умолчанию (если бот не передал свой) ---
PLAN_DAYS=30
# 0 — без ограничения трафика
PLAN_TOTAL_GB=0

# --- 3x-ui ---
# mock — тесты/разработка без панели; real — настоящая панель
XUI_MODE=mock
# База панели БЕЗ webBasePath, например https://msk.vitosamintm.ru:34473
# (панель НЕ трогать без явного запроса владельца)
XUI_BASE_URL=
# webBasePath панели: '' или '/TWgF.../'. В конфиге панели заканчивается слэшем.
XUI_WEB_BASE_PATH=/
# Вариант 1 (рекомендуется): Bearer API Token из Settings → Security → API Token
XUI_API_TOKEN=
# Вариант 2: логин/пароль админа панели (cookie-сессия)
XUI_USERNAME=
XUI_PASSWORD=
# ID инбаунда VLESS/Reality, к которому добавлять клиентов
XUI_INBOUND_ID=1
# 1 — проверять TLS-сертификат панели; 0 — для self-signed
XUI_VERIFY_TLS=1
XUI_TIMEOUT=10
# auto — определить автоматически; legacy — /panel/api/inbounds/*; modern — /panel/api/clients/*
XUI_CLIENT_API=auto
# flow клиента VLESS: для Reality/TLS-инбаунда обычно xtls-rprx-vision, иначе пусто
XUI_CLIENT_FLOW=
# Шаблон sub-ссылки с {sub_id}. ОБЯЗАТЕЛЬНО проверить в панели!
# Классический 3x-ui:  https://<host>:2096/sub/{sub_id}
# Новый 3.x (отдельный sub-сервер): https://<sub-host>:2096/<случайный-subPath>/{sub_id}
# Если пусто в real-режиме, собирается как {XUI_BASE_URL}/sub/{sub_id}.
SUB_URL_TEMPLATE=
# Имя профиля в приложении; {email} подставляется
PROFILE_NAME_TEMPLATE={email}
